NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/natural_root_healing
# Development only: reflects any requesting origin so localhost/127.0.0.1 both work.
# Use an explicit comma-separated allowlist in production.
FRONTEND_ORIGINS=*
LOG_LEVEL=info
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=nrh_session
CSRF_COOKIE_NAME=nrh_csrf
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Set only when the frontend and backend intentionally share a cookie domain.
# COOKIE_DOMAIN=
